#!/usr/bin/env bash
set -euo pipefail

# CANONICAL GENERATION PROMPT
#
# The text below is the authoritative prompt for this script.
# It MUST be copied verbatim into the generated script header.
# Only add the leading "# " comment prefix; do not reword or reorder.
#
# Test Runner (Bash)
#
# Runs executable files or .sh scripts given as arguments.
# Directories are expanded to their contained files (non-recursive).
# All files are collected first before execution.
#
# Execution rules:
# - Executable files are run directly.
# - Non-executable *.sh files are run via bash.
# - Missing or non-runnable files/directories cause a fatal error ("die").
#
# Test protocol (simple tests):
# - A test is a normal program or script.
# - Exit status 0 means success.
# - Any non-zero exit status means failure.
# - Any output on stderr means failure.
# - Standard output and standard error and exit status are collected in temporary
#   files named after test designations
# - Standard output, standard error, and exit status are written to separate
#   temporary files named after the test designation (e.g. .out, .err, .status).
#   This can be used for later inspection (with parameter -d)
#
# Phases:
# - Phase T: run each file once, detect testsuites, and count suite tests.
# - Phase S: run all tests generated by detected testsuites.
#
# Testsuite protocol:
# - A test is a testsuite generator if:
#     * exit status == 88
#     * stdout starts with the line "#!testsuite"
# - Each following stdout line defines one test invocation.
# - Argument parsing:
#     * lines containing TABs are split on TABs
#     * otherwise parsed as normal bash words (with quoting)
# - Description lines ("# ") are ignored for testsuite generators.
#
# Progress output (one line per test):
#
#   [T 1/3] ./test_basic  0.012s
#   [S 2/10] ./test_math::add (1 2)  0.000s
#   [S 3/10] ./test_math::div (4 2)  0.000s  -- division works
#
# - Format: [PHASE CURRENT/TOTAL] DESIGNATION  TIME [-- DESCRIPTION]
# - TIME is seconds with up to 3 decimals, unit immediately appended (e.g. 12.345s).
# - DESIGNATION = filename + optional test name + remaining arguments
#   (test name is not repeated inside arguments)
# - If stdout first line starts with "# ", the rest is shown as DESCRIPTION.
#
# Errors:
# - If a test writes to stderr or exits non-zero (except testsuite exit 88):
#     * print "ERROR" and full stdout/stderr/status to stderr
#     * continue running remaining tests
# - Final exit status is non-zero if any test failed.
#
# Optional parameters:
# - -v : pass test stdout/stderr through in addition to capturing
# - -d : keep temporary directory after execution
#
# Shell strictness:
# - Runner uses: set -euo pipefail
# - Runner logic failures abort immediately.
# - Test failures are explicitly handled and must not trigger set -e.
#
# Environment:
# - GNU tools on Linux (Ubuntu)
# - Single temporary directory for all outputs
#
# Please avoid bugs:
#
# - The runner MUST explicitly capture and propagate the exit status of each test
#   execution. Testsuite detection MUST NOT rely on the implicit shell `$?`
#   outside the immediate execution context. (this is added because ChatGPT introduced a bug)
# - Don't do something like: printf '--- stdout ---\n'
#   This results in an error: printf: --: invalid option
#
# Prompt reproduction rule:
#
# It MUST be copied verbatim (byte-for-byte), into the generated script header.
# However, if not yet prefixed with "# ", add a comment prefix.

usage() {
  printf 'usage: %s [-v] [-d] <file-or-dir>...\n' "${0##*/}" >&2
  exit 1
}

V_PASS=0
KEEP_TMP=0
while getopts ":vd" opt; do
  case "$opt" in
    v) V_PASS=1 ;;
    d) KEEP_TMP=1 ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[[ "$#" -ge 1 ]] || usage

TMPDIR="$(mktemp -d)"
cleanup() {
  if [[ "$KEEP_TMP" -eq 0 ]]; then
    rm -rf "$TMPDIR"
  else
    printf 'keeping tmpdir: %s\n' "$TMPDIR" >&2
  fi
}
trap cleanup EXIT

had_test_error=0

die() {
  printf 'ERROR\n' >&2
  printf 'die: %s\n' "$1" >&2
  exit 1
}

sanitize_name() {
  local s="$1"
  s="${s//\//__}"
  s="${s// /_}"
  s="${s//:/_}"
  s="${s//[^A-Za-z0-9._-]/_}"
  printf '%s' "$s"
}

is_sh() { [[ "$1" == *.sh ]]; }

ensure_dir_ok_or_die() {
  local d="$1"
  [[ -e "$d" ]] || die "path not found: $d"
  [[ -d "$d" ]] || die "expected directory, got file: $d"
  [[ -x "$d" ]] || die "directory not executable: $d"
}

ensure_runnable_file_or_die() {
  local f="$1"
  [[ -e "$f" ]] || die "path not found: $f"
  [[ -d "$f" ]] && die "expected file, got directory: $f"
  if [[ -x "$f" ]]; then
    return 0
  fi
  if is_sh "$f"; then
    return 0
  fi
  die "file not executable and not .sh: $f"
}

report_error() {
  # $1 designation, $2 status, $3 stdout_file, $4 stderr_file
  printf 'ERROR\n' >&2
  printf 'test: %s\n' "$1" >&2
  printf 'status: %s\n' "$2" >&2

  printf '%s\n' '--- stdout ---' >&2
  if [[ -s "$3" ]]; then
    cat "$3" >&2
    tail -c 1 "$3" | od -An -tx1 | grep -qi '0a' || printf '\n' >&2
  else
    printf '(empty)\n' >&2
  fi

  printf '%s\n' '--- stderr ---' >&2
  if [[ -s "$4" ]]; then
    cat "$4" >&2
    tail -c 1 "$4" | od -An -tx1 | grep -qi '0a' || printf '\n' >&2
  else
    printf '(empty)\n' >&2
  fi

  had_test_error=1
}

# --- testsuite line parsing ---
PARSED_ARGS=()

parse_suite_line() {
  local line="$1"
  PARSED_ARGS=()

  if [[ "$line" == *$'\t'* ]]; then
    local IFS=$'\t'
    # shellcheck disable=SC2206
    PARSED_ARGS=($line)
    return 0
  fi

  # Bash-style parsing via eval; suite output is assumed trusted input.
  eval "PARSED_ARGS=($line)"
}

format_args_for_designation() {
  local -a args=("$@")
  if [[ "${#args[@]}" -eq 0 ]]; then
    printf ''
    return 0
  fi
  printf '%q ' "${args[@]}" | sed 's/ $//'
}

extract_description_from_stdout() {
  local stdout_file="$1"
  local first
  first="$(head -n 1 "$stdout_file" || true)"
  if [[ "$first" == '# '* ]]; then
    printf '%s' "${first:2}"
    return 0
  fi
  printf ''
}

is_testsuite_output() {
  [[ "$(head -n 1 "$1" || true)" == "#!testsuite" ]]
}

write_testsuite_lines() {
  # Drop the "#!testsuite" marker and "# " description lines.
  tail -n +2 "$1" | grep -v '^# ' >"$2" || true
}

# --- execution wrapper ---
RUN_STATUS=0
RUN_DT="0.000000"
RUN_DESC=""

run_once_capture() {
  # $1 file, $2 designation, $3 phase, $4 idx, $5 total, $6 out, $7 err, $8 status_file, $@ args
  local file="$1"
  local designation="$2"
  local phase="$3"
  local idx="$4"
  local total="$5"
  local out_file="$6"
  local err_file="$7"
  local status_file="$8"
  shift 8

  : >"$out_file"
  : >"$err_file"
  : >"$status_file"

  local start end
  start="$(date +%s.%N)"

  set +e
  if [[ -x "$file" ]]; then
    if [[ "$V_PASS" -eq 1 ]]; then
      "$file" "$@" > >(tee "$out_file") 2> >(tee "$err_file" >&2)
    else
      "$file" "$@" >"$out_file" 2>"$err_file"
    fi
  else
    if [[ "$V_PASS" -eq 1 ]]; then
      bash "$file" "$@" > >(tee "$out_file") 2> >(tee "$err_file" >&2)
    else
      bash "$file" "$@" >"$out_file" 2>"$err_file"
    fi
  fi
  RUN_STATUS=$?
  set -e

  printf '%s\n' "$RUN_STATUS" >"$status_file"

  end="$(date +%s.%N)"
  RUN_DT="$(awk -v s="$start" -v e="$end" 'BEGIN { printf "%.3f", (e - s) }')"

  if [[ "$RUN_STATUS" -eq 88 ]] && is_testsuite_output "$out_file"; then
    RUN_DESC=""
  else
    RUN_DESC="$(extract_description_from_stdout "$out_file")"
  fi

  if [[ -n "$RUN_DESC" ]]; then
    printf '[%s %d/%d] %s  %ss  -- %s\n' "$phase" "$idx" "$total" "$designation" "$RUN_DT" "$RUN_DESC"
  else
    printf '[%s %d/%d] %s  %ss\n' "$phase" "$idx" "$total" "$designation" "$RUN_DT"
  fi
}

FILES=()
collect_files_or_die() {
  FILES=()
  local arg
  for arg in "$@"; do
    [[ -e "$arg" ]] || die "path not found: $arg"
    if [[ -d "$arg" ]]; then
      ensure_dir_ok_or_die "$arg"
      while IFS= read -r -d '' f; do
        FILES+=("$f")
      done < <(find "$arg" -maxdepth 1 -type f -print0)
    else
      FILES+=("$arg")
    fi
  done
}

SUITES=()
declare -A SUITE_NTEST
TOTAL_S_TESTS=0

phase_T() {
  local total_files="${#FILES[@]}"
  local i f
  for i in "${!FILES[@]}"; do
    f="${FILES[$i]}"
    local n=$((i + 1))

    ensure_runnable_file_or_die "$f"

    local base out err st suite_lines
    base="$(sanitize_name "$f")"
    out="$TMPDIR/${base}.out"
    err="$TMPDIR/${base}.err"
    st="$TMPDIR/${base}.status"
    suite_lines="$TMPDIR/${base}.suite"

    run_once_capture "$f" "$f" "T" "$n" "$total_files" "$out" "$err" "$st"
    local status
    status="$(<"$st")"

    if [[ "$status" -eq 88 ]] && is_testsuite_output "$out"; then
      SUITES+=("$f")
      write_testsuite_lines "$out" "$suite_lines"

      local c=0
      if [[ -s "$suite_lines" ]]; then
        c="$(awk 'NF{c++} END{print c+0}' "$suite_lines")"
      fi
      SUITE_NTEST["$f"]="$c"
      TOTAL_S_TESTS=$((TOTAL_S_TESTS + c))

      if [[ -s "$err" ]]; then
        report_error "$f" "$status" "$out" "$err"
      fi
      continue
    fi

    if [[ -s "$err" || "$status" -ne 0 ]]; then
      report_error "$f" "$status" "$out" "$err"
    fi
  done
}

phase_S() {
  local idx=0
  local suite
  for suite in "${SUITES[@]}"; do
    ensure_runnable_file_or_die "$suite"

    local base2 suite_lines
    base2="$(sanitize_name "$suite")"
    suite_lines="$TMPDIR/${base2}.suite"

    local expected="${SUITE_NTEST[$suite]:-0}"
    [[ "$expected" -gt 0 ]] || continue

    local line
    while IFS= read -r line; do
      [[ -z "${line//[[:space:]]/}" ]] && continue

      parse_suite_line "$line"
      local -a args=("${PARSED_ARGS[@]}")

      idx=$((idx + 1))

      local testname rest_argstr designation
      testname=""
      if [[ "${#args[@]}" -ge 1 ]]; then
        testname="${args[0]}"
      fi

      if [[ "${#args[@]}" -gt 1 ]]; then
        rest_argstr="$(format_args_for_designation "${args[@]:1}")"
      else
        rest_argstr=""
      fi

      if [[ -n "$testname" ]]; then
        if [[ -n "$rest_argstr" ]]; then
          designation="${suite}::${testname} (${rest_argstr})"
        else
          designation="${suite}::${testname}"
        fi
      else
        designation="${suite}"
      fi

      local base out err st
      base="$(sanitize_name "$designation")"
      out="$TMPDIR/${base}.out"
      err="$TMPDIR/${base}.err"
      st="$TMPDIR/${base}.status"

      run_once_capture "$suite" "$designation" "S" "$idx" "$TOTAL_S_TESTS" "$out" "$err" "$st" "${args[@]}"
      local status
      status="$(<"$st")"

      if [[ -s "$err" || "$status" -ne 0 ]]; then
        report_error "$designation" "$status" "$out" "$err"
      fi
    done <"$suite_lines"
  done
}

collect_files_or_die "$@"
phase_T
phase_S

if [[ "$had_test_error" -ne 0 ]]; then
  exit 1
fi
exit 0
